# Base URL of a running keळ backend (FastAPI, exposes /v1/*). Optional.
# Without it, /problems and /search render an honest "not connected" state.
NEXT_PUBLIC_KEL_API_URL=http://localhost:8000
# Where "Sign in" should send people (your deployment's identity provider). Optional.
NEXT_PUBLIC_KEL_SIGNIN_URL=

# --- Website analytics + error monitoring (both OFF unless set; both skipped when the visitor sends Do Not Track / GPC) ---
# Cookieless product analytics via Plausible (cloud or self-hosted). Set the site's domain as registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: your self-hosted Plausible script URL (default https://plausible.io/js/script.tagged-events.js)
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Browser error reporting via Sentry (no tracing, no replay, no PII). Use a dedicated *frontend* project DSN.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_KEL_ENV=production
NEXT_PUBLIC_KEL_RELEASE=
