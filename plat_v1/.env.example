# Copy to .env. Nothing here is required to run the offline test suite.

# Postgres 15+ with pgvector. Replace the whole line -- the placeholder below
# connects as a role literally named "user".
DATABASE_URL=postgresql://user:pass@localhost:5432/plat_v1

# The schema plat_v1 owns. search_path is this schema first, then whichever
# schema hosts pgvector (discovered, not assumed -- on Supabase `pgcrypto` is
# in `extensions` but `vector` can be in `public`).
#
# This is what lets plat_v1 share a database with backend_v2. Both define
# `task_nodes` and `traces` with different columns, so sharing a *schema*
# would mean CREATE TABLE IF NOT EXISTS silently skipping and this app
# running against the other one's tables. Ours being first means our tables
# shadow theirs -- and because pgvector may drag `public` onto the path,
# `verify_isolation` re-checks at startup that every table we own really does
# resolve to us. `public` is rejected outright as a value here.
#
# On Supabase, use the SESSION pooler (port 5432), not the transaction pooler
# (6543): transaction-mode pooling preserves neither the search_path nor
# asyncpg's prepared statements.
DB_SCHEMA=plat_v1

# Model implementations and decomposition. Without it the deterministic
# implementations still run; anything that needs a model fails its stage and
# escalates, which is the intended degradation.
ANTHROPIC_API_KEY=

# Embeddings for hybrid retrieval. Without it task nodes are written with a
# NULL embedding and matching falls back to Postgres full-text only.
VOYAGE_API_KEY=

FRONTEND_ORIGIN=http://localhost:3000

# --- The four decisions implement.md says to raise rather than guess -------
# See the README section of the same name before changing any of these.

# 1. Auto-match threshold. Needs tuning against real prompts.
AUTO_MATCH_THRESHOLD=0.03

# 2. Let map_to_schema run unattended on a layout never seen before.
ALLOW_UNREVIEWED_FIRST_LAYOUT_MAPPING=false

# 3. Where run artifacts live once the temp directory is gone.
ARTIFACT_ROOT=./artifacts
KEEP_RUN_ARTIFACTS=true

# 4. Whether a failed stage discards the partial outputs. Either way the run
#    is reported as failed.
FAIL_RUN_ON_STAGE_FAILURE=true

# --- Router ---
QUALITY_BAR_TOLERANCE=0.05
MAX_ESCALATIONS=3
