{
  "title": "Stealth ingestion & retrieval (ops)",
  "uid": "stealth-ingestion-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "stealth",
    "ingestion"
  ],
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "Control DB",
        "type": "datasource",
        "query": "grafana-postgresql-datasource"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 101,
      "type": "row",
      "title": "Ingestion",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 102,
      "type": "bargauge",
      "title": "Queue by status",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT now() AS time, status AS metric, count(*) AS value FROM ingestion_jobs GROUP BY status"
        }
      ]
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "Completed per 5m (throughput)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(completed_at, '5m') AS time, count(*) AS done FROM ingestion_jobs WHERE status='done' AND $__timeFilter(completed_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Job duration avg / p95 (s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(completed_at, '5m') AS time, avg(extract(epoch from completed_at-started_at)) AS avg_s, percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch from completed_at-started_at)) AS p95_s FROM ingestion_jobs WHERE status='done' AND $__timeFilter(completed_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Failures: retryable / permanent / expired leases",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT now() AS time, count(*) FILTER (WHERE status='retryable_failed') AS retryable, count(*) FILTER (WHERE status='failed') AS permanent, count(*) FILTER (WHERE status='processing' AND lease_until < now()) AS expired_leases FROM ingestion_jobs"
        }
      ]
    },
    {
      "id": 106,
      "type": "table",
      "title": "Recent permanent failures",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 16,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT id, job_type, attempts, left(last_error, 160) AS last_error, completed_at FROM ingestion_jobs WHERE status='failed' ORDER BY completed_at DESC NULLS LAST LIMIT 15"
        }
      ]
    },
    {
      "id": 107,
      "type": "row",
      "title": "Semantic providers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 108,
      "type": "timeseries",
      "title": "Model + embedding calls (ingestion) per 5m",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(occurred_at, '5m') AS time, count(*) FILTER (WHERE operation='embedding') AS embedding_calls, count(*) FILTER (WHERE operation LIKE 'judge:%') AS judge_calls FROM llm_spend WHERE scope_key='ingestion' AND $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "Judge provider mix (fallback rate)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(created_at, '5m') AS time, coalesce(judge_provider,'none') AS metric, count(*) AS value FROM identity_decisions WHERE $__timeFilter(created_at) GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 110,
      "type": "timeseries",
      "title": "Provider failures / 429s (from job errors)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(coalesce(completed_at, claimed_at), '5m') AS time, count(*) FILTER (WHERE last_error ~ 'EmbeddingError') AS embedding, count(*) FILTER (WHERE last_error ~ 'SemanticJudgmentUnavailable') AS judge, count(*) FILTER (WHERE last_error ~* '429|RESOURCE_EXHAUSTED|rate.?limit') AS rate_limited FROM ingestion_jobs WHERE last_error IS NOT NULL AND $__timeFilter(coalesce(completed_at, claimed_at)) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 111,
      "type": "row",
      "title": "Retrieval",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 112,
      "type": "timeseries",
      "title": "Retrievals: total vs degraded",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(created_at, '5m') AS time, count(*) AS total, count(*) FILTER (WHERE degraded) AS degraded FROM retrieval_decisions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 113,
      "type": "timeseries",
      "title": "Candidates per retrieval (goals / procedures)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(created_at, '5m') AS time, avg(cardinality(goal_ids)) AS goals, avg(cardinality(procedure_ids)) AS procedures FROM retrieval_decisions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 114,
      "type": "timeseries",
      "title": "Shards touched / unavailable",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(created_at, '5m') AS time, avg(CASE WHEN jsonb_typeof(detail->'shards')='array' THEN jsonb_array_length(detail->'shards') END) AS shards_touched, count(*) FILTER (WHERE jsonb_typeof(detail->'unavailable_shards')='array' AND jsonb_array_length(detail->'unavailable_shards')>0) AS with_unavailable FROM retrieval_decisions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 115,
      "type": "row",
      "title": "Database / shards",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 116,
      "type": "table",
      "title": "Shard registry + routed objects",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT k.shard_id, k.status, k.weight, count(r.object_id) AS routed_objects FROM knowledge_shards k LEFT JOIN object_routes r ON r.home_shard_id = k.shard_id GROUP BY 1,2,3 ORDER BY 1"
        }
      ]
    },
    {
      "id": 117,
      "type": "stat",
      "title": "Projection lag",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT now() AS time, count(*) FILTER (WHERE status='pending') AS pending, count(*) FILTER (WHERE status='failed') AS failed, coalesce(extract(epoch from now()-min(created_at) FILTER (WHERE status='pending')),0) AS oldest_pending_s FROM projection_outbox"
        }
      ]
    },
    {
      "id": 118,
      "type": "stat",
      "title": "Control DB size + connections",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT now() AS time, pg_database_size(current_database()) AS bytes, (SELECT count(*) FROM pg_stat_activity WHERE datname=current_database()) AS connections"
        }
      ]
    },
    {
      "id": 119,
      "type": "row",
      "title": "Cost",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 120,
      "type": "timeseries",
      "title": "Spend per hour (USD) vs daily cap",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(occurred_at, '1h') AS time, sum(estimated_cost) AS usd FROM llm_spend WHERE $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 121,
      "type": "table",
      "title": "Spend last 24h by provider / operation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 16,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT provider, operation, count(*) AS calls, sum(input_tokens) AS tokens_in, sum(output_tokens) AS tokens_out, round(sum(estimated_cost)::numeric, 4) AS usd FROM llm_spend WHERE occurred_at > now() - interval '24 hours' GROUP BY 1,2 ORDER BY usd DESC"
        }
      ]
    }
  ]
}
