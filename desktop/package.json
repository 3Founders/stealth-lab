{
  "name": "kell-desktop",
  "version": "0.1.15",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev -p 3400",
    "bundle:cli": "node scripts/bundle-cli.mjs",
    "build": "npm run bundle:cli && next build && node scripts/standalone.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 3400",
    "electron:build": "tsc -p electron",
    "dist": "npm run build && npm run electron:build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "org.kell.desktop",
    "productName": "kell",
    "icon": "build/icon.png",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**",
      ".next/**",
      "public/**",
      "lib/**",
      "vendor/**",
      "next.config.mjs",
      "!.next/cache/**",
      "!node_modules/@opencode/cli/**",
      "!node_modules/@opencode/cli-windows-x64-baseline/**",
      "!node_modules/@next/swc-*/**",
      "!node_modules/typescript/**",
      "!.next/standalone/.next/cache/**",
      "!node_modules/next/**",
      "!node_modules/@next/**",
      "!node_modules/effect/**",
      "!node_modules/@img/**",
      "!node_modules/sharp/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/caniuse-lite/**",
      "!node_modules/styled-jsx/**",
      "!node_modules/@opencode/client/**",
      "!node_modules/@opencode/protocol/**",
      "!node_modules/@opencode/schema/**",
      "!node_modules/marked/**",
      "!node_modules/@fontsource/**",
      "!node_modules/scheduler/**"
    ],
    "asarUnpack": [
      "vendor/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "kell-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AnujB05",
        "repo": "kell-desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@opencode/cli": "2.2.5",
    "@opencode/client": "2.2.5",
    "electron-updater": "^6.8.11",
    "marked": "^18.1.3",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@45.2.1": true
  }
}
