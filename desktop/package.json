{
  "name": "kell-desktop",
  "version": "0.1.30",
  "private": true,
  "description": "kell desktop: the cheapest model that can do it, with the right tool",
  "homepage": "https://www.kell.org.in",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev -p 3400",
    "bundle:cli": "node scripts/bundle-cli.mjs",
    "build": "npm run bundle:cli && next build && node scripts/standalone.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 3400",
    "electron:build": "tsc -p electron && npm run electron:bundle",
    "electron:bundle": "esbuild electron/updater.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/dist/updater.js",
    "predist": "node scripts/seed-electron-checksums.mjs",
    "dist": "npm run build && npm run electron:build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && npm run electron:build && electron-builder --linux AppImage deb --publish never"
  },
  "build": {
    "appId": "org.kell.desktop",
    "productName": "kell",
    "icon": "build/icon.png",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**",
      "build/icon.png",
      ".next/**",
      "public/**",
      "lib/**",
      "vendor/**",
      "next.config.mjs",
      "!.next/cache/**",
      "!node_modules/@opencode/cli/**",
      "!node_modules/@opencode/cli-windows-x64-baseline/**",
      "!node_modules/@next/swc-*/**",
      "!node_modules/typescript/**",
      "!.next/standalone/.next/cache/**",
      "!node_modules/next/**",
      "!node_modules/@next/**",
      "!node_modules/effect/**",
      "!node_modules/@img/**",
      "!node_modules/sharp/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/caniuse-lite/**",
      "!node_modules/styled-jsx/**",
      "!node_modules/@opencode/client/**",
      "!node_modules/@opencode/protocol/**",
      "!node_modules/@opencode/schema/**",
      "!node_modules/marked/**",
      "!node_modules/@fontsource/**",
      "!node_modules/scheduler/**"
    ],
    "asarUnpack": [
      "vendor/**"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "kell <https://www.kell.org.in>",
      "synopsis": "kell: the cheapest model that can do it, with the right tool",
      "artifactName": "kell-${version}-${arch}.${ext}",
      "executableName": "kell",
      "files": [
        "!node_modules/@opencode/cli-linux-x64-baseline/**",
        "!node_modules/@opencode/cli-linux-x64-musl/**",
        "!node_modules/@opencode/cli-linux-x64-baseline-musl/**",
        "!node_modules/@opencode/cli-linux-arm64/**",
        "!node_modules/@opencode/cli-linux-arm64-musl/**",
        "!node_modules/node-pty/prebuilds/darwin-arm64/**",
        "!node_modules/node-pty/prebuilds/darwin-x64/**",
        "!node_modules/node-pty/prebuilds/win32-arm64/**",
        "!node_modules/node-pty/prebuilds/win32-x64/**"
      ]
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "kell-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AnujB05",
        "repo": "kell-desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@opencode/cli": "2.2.5",
    "@opencode/client": "2.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx": "^9.15.4",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "fs-extra": "^10.1.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "next": "^15.5.25",
    "node-pty": "^1.1.0",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@45.2.1": true
  }
}
