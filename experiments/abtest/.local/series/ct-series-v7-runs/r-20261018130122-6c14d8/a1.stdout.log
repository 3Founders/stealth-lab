icks.com/en/sql/language-manual/functions/date_add.html\n        return exp.TsOrDsAdd(","numLines":50,"startLine":1,"totalLines":194}},"tool_result_meta":[{"id":"call_97a99f9e63004c5199","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
