d = self.sql(expression, \"this\")\n            start = self.sql(expression, \"expression\")\n\n            if expression.unit:\n                return self.func(\"DATEDIFF\", unit_to_var(expression), start, end)\n\n            return self.func(\"DATEDIFF\", end, start)\n","numLines":65,"startLine":130,"totalLines":194}},"tool_result_meta":[{"id":"call_94e036c48b3945608a","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
