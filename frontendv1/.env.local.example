# Backend API base URL (FastAPI, default http://localhost:8000)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Sign-in: Supabase Auth (canonical identity) ---
# From the Supabase dashboard -> Project Settings -> API:
#   NEXT_PUBLIC_SUPABASE_URL      -> Project URL  (https://<ref>.supabase.co)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY -> the "anon" / publishable key
#
# The anon key is safe to ship in the browser bundle (it only works within
# Row Level Security). NEVER put the service_role / secret key here or
# anywhere in frontend code — it bypasses RLS.
#
# When both are set, /auth offers email/password + "Continue with Google"
# and the app sends "Authorization: Bearer <supabase access token>" to the
# backend, which must have the matching SUPABASE_PROJECT_URL /
# SUPABASE_JWT_AUDIENCE and a P-256 (ECC) JWT signing key set as current
# (that key issues `alg: ES256` tokens, which the backend verifies).
#
# Supabase dashboard -> Authentication -> URL Configuration: add
#   http://localhost:3000/auth/callback   (and the deployed equivalent)
# to the redirect allow-list, and enable the Google provider under
# Authentication -> Providers.
#NEXT_PUBLIC_SUPABASE_URL=
#NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# When unset, /auth falls back to the developer viewer identity (X-Viewer-Id
# header) — only valid while the backend stays in the public posture.
