# Backend API base URL (FastAPI, default http://localhost:8000)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Sign-in (optional) ---
# Real OIDC sign-in (Authorization Code + PKCE, provider-agnostic via
# discovery). When both are set, /auth shows "Continue with Google" and the
# frontend sends "Authorization: Bearer <token>" to the backend, which
# validates the RS256 token against the issuer's JWKS (backend must have
# matching OIDC_ISSUER / OIDC_AUDIENCE set).
# Google: NEXT_PUBLIC_OIDC_AUTHORITY=https://accounts.google.com
#NEXT_PUBLIC_OIDC_AUTHORITY=
#NEXT_PUBLIC_OIDC_CLIENT_ID=
#
# When unset, /auth falls back to the developer viewer identity (X-Viewer-Id
# header) — only valid while the backend stays in the public posture.

