DATABASE_URL=postgresql://user:password@host:5432/postgres

# MCP server auth (backend/README_MCP_SERVER.md) -- required for HTTP mode;
# the server fails at import time, not on first tool call, if this is
# unset. stdio mode bypasses auth entirely, by protocol design, and does
# not need it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STEALTHLAB_MCP_TOKEN=

# Debate panel -- three distinct model families (Section 7)
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=

# Independent judge (Section 8.1) -- must be a fourth, distinct family,
# since the panel above already uses the other three configured providers
GOOGLE_API_KEY=

# Embeddings
VOYAGE_API_KEY=

# Frontend origin for CORS (app/main.py) -- the deployed frontend URL
FRONTEND_ORIGIN=http://localhost:3000

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6
# FIREWORKS_MODEL=accounts/fireworks/models/kimi-k3
# OPENAI_MODEL=gpt-4.1
# GEMINI_MODEL=gemini-2.5-pro
# MAX_DEBATE_ROUNDS=5
# MIN_SUPPORTERS_FOR_EVAL=2
# GROUNDEDNESS_THRESHOLD=0.5

# --- Local models (development without paid API access) ---
# Set USE_LOCAL_MODELS=true to route the debate panel, judge, and
# embeddings at a local OpenAI-compatible server instead of paid APIs.
# Verified against Ollama's OpenAI-compatible endpoint.
#
#   ollama serve
#   ollama pull llama3.2 && ollama pull qwen2.5 && ollama pull mistral
#   ollama pull gemma2 && ollama pull mxbai-embed-large
#
# mxbai-embed-large is 1024-dim, matching the VECTOR(1024) schema column.
# Substituting a different-dimension model requires altering that column
# and re-embedding everything, so check before switching.
USE_LOCAL_MODELS=false
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_PANEL_MODELS=llama3.2,qwen2.5,mistral
# LOCAL_JUDGE_MODEL=gemma2
# LOCAL_EMBEDDING_MODEL=mxbai-embed-large

# --- V2 governance ---
# Rate limiting and LLM spend caps. On by default: an unprotected public
# endpoint that spends money per call should require deliberate opt-out.
GOVERNANCE_ENABLED=true
DAILY_LLM_BUDGET_USD=10.0
PER_VIEWER_DAILY_BUDGET_USD=1.0

# --- V2 access control ---
# Private visibility stays off until real auth exists; the app refuses to
# start if these are set to true/false respectively.
PRIVATE_VISIBILITY_ENABLED=false
REAL_AUTH_ENABLED=false

# --- Supabase Auth (canonical end-user identity, launch compliance Phase 1) ---
# Supabase Auth issues OIDC-shaped JWTs. Set BOTH of the following (setting
# exactly one is a half-configured posture and the app refuses to boot):
#
#   SUPABASE_PROJECT_URL  -> https://<ref>.supabase.co  (the SAME project
#                            whose Postgres is your DATABASE_URL)
#   SUPABASE_JWT_AUDIENCE -> "authenticated"  (Supabase's default aud claim)
#
# The backend then verifies every "Authorization: Bearer <token>" against
#   issuer  = {SUPABASE_PROJECT_URL}/auth/v1
#   JWKS    = {issuer}/.well-known/jwks.json
# with ES256/RS256 ONLY. HS256 (the legacy shared-secret mode) is NEVER
# accepted -- the project MUST be on asymmetric JWT signing keys:
#   Supabase dashboard -> Project Settings -> JWT Keys -> "Migrate to
#   asymmetric keys" (ECC / P-256). Do this before setting these vars.
#
# Frontend counterpart: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# in frontendv1/.env.local  (the anon key is public by design; the
# service_role key must NEVER reach the browser or this file).
SUPABASE_PROJECT_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Hosted execution (launch compliance Phase 1 / LC-001) ---
# Off by default: repo_path stays caller-provided (local/loopback posture).
# When true, repo-executing entry points refuse any path that is not a
# registered workspace's server-side root, and the app refuses to boot
# without OIDC/Supabase identity configured above.
HOSTED_EXECUTION_ENABLED=false

# --- General Compute (hosted open-weight, OpenAI-compatible) ---
# https://docs.generalcompute.com -- check the models page for current
# catalog before setting these. Cheaper than the closed frontier roster,
# real hosted latency, genuine open-weight reasoning quality.
USE_GENERAL_COMPUTE=false
GENERAL_COMPUTE_API_KEY=
GENERAL_COMPUTE_BASE_URL=https://api.generalcompute.com/v1
# Comma-separated, at least 3, must be genuinely distinct families:
# GENERAL_COMPUTE_PANEL_MODELS=deepseek-v4-pro,qwen3.6-235b,glm-5.2
GENERAL_COMPUTE_PANEL_MODELS=
# Must differ in family from all three panel models above:
# GENERAL_COMPUTE_JUDGE_MODEL=kimi-k2.7-code
GENERAL_COMPUTE_JUDGE_MODEL=
