# Base URL of a running keळ backend (FastAPI, exposes /v1/*). Optional.
# Without it, /problems and /search render an honest "not connected" state.
NEXT_PUBLIC_KEL_API_URL=http://localhost:8000

# --- Authentication (Supabase Auth: Google, GitHub, email+password) ---
# Public, deployment-side config -- safe in a browser bundle by Supabase's
# own design (the anon key identifies the project; the backend verifies
# every access token itself, see backend/.env's SUPABASE_PROJECT_URL /
# SUPABASE_JWT_AUDIENCE). NEVER put a service-role key here. Without both
# set, /sign-in renders an honest "not connected" state and no auth UI
# pretends to work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile SITE key (public). Put the matching SECRET key in Supabase ->
# Authentication -> Attack Protection -> CAPTCHA (provider: Turnstile). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# MCP clients (Claude, Cursor, VS Code) sign in to the keळ MCP server through
# the same project: Supabase's OAuth 2.1 server sends them to /oauth/consent.
# In the Supabase dashboard (Authentication -> OAuth Server) set the
# authorization path to /oauth/consent. Connected apps: /account/connections.

# --- Website analytics + error monitoring (both OFF unless set; both skipped when the visitor sends Do Not Track / GPC) ---
# Cookieless product analytics via Plausible (cloud or self-hosted). Set the site's domain as registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: your self-hosted Plausible script URL (default https://plausible.io/js/script.tagged-events.js)
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Browser error reporting via Sentry (no tracing, no replay, no PII). Use a dedicated *frontend* project DSN.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_KEL_ENV=production
NEXT_PUBLIC_KEL_RELEASE=

# --- Admin console (optional) ---
# Address of the deployed admin app (admin/), e.g. https://admin.example.com. When set, /sign-in and the footer offer an
# "Administrator sign in" link to it. The admin app is a separate origin with its own sign-in; the backend decides who
# may use it. https only (http is accepted for localhost). Leave empty and no link is shown.
NEXT_PUBLIC_ADMIN_URL=

# --- Contact page (/contact), all optional ---
# A booking page (Calendly, Cal.com, ...). https only. When set, /contact shows a "Book a call" button; when empty, none.
NEXT_PUBLIC_BOOKING_URL=
# Where to write when the form cannot be used. Shown as a mailto line on /contact when set.
NEXT_PUBLIC_CONTACT_EMAIL=
